# Optional: without these variables, PeerJS uses its public cloud signaling service.
# Vercel hosts the static client; WebRTC race data flows directly between players.
# VITE_PEER_HOST=your-peer-server.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true

# Optional RTCIceServer[] JSON, replacing PeerJS's default ICE server list.
# Example with a public STUN server:
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# Restrictive networks may require TURN. Every VITE_* value is public in the browser.
# Never put private server secrets or long-lived TURN credentials here.
# For production TURN, obtain short-lived credentials from your own authenticated API
# and adapt peerOptions() in src/network.ts to supply them at connection time.
